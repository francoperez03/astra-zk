{
  "name": "@astra/sdk",
  "version": "0.1.0",
  "description": "Astra Privacy SDK for Stellar",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@noble/hashes": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "@types/node": "^20.12.0"
  },
  "files": ["dist"],
  "keywords": ["stellar", "privacy", "zk", "zero-knowledge"],
  "license": "MIT"
}
